<?xml version="1.0"?>
<package format="3">
  <name>drone_gui</name>
  <version>0.0.1</version>
  <description>GUI for the drone using ImGui + GLFW</description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <!-- REQUIRED so ament_package() exists -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>drone_core</depend>

  <!-- ImGui/GLFW/OpenGL handled manually in CMake, so NO ros deps here -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
