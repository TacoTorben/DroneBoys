prefix=/home/dksoren/drone_boys/install/drone_gui
exec_prefix=${prefix}
includedir=/home/dksoren/drone_boys/install/drone_gui/include
libdir=/home/dksoren/drone_boys/install/drone_gui/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.3.4
URL: https://www.glfw.org/
Requires.private:  x11
Libs: -L${libdir} -lglfw3
Libs.private:  -lrt -lm -ldl
Cflags: -I${includedir}
